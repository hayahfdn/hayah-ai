# Copy to .env and fill in. Never commit .env or the secrets/ folder.
POSTGRES_PASSWORD=change-me-long-random
WEB_PORT=8080

HAYAH_ENV=production
HAYAH_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
HAYAH_CORS_ORIGINS=https://ops.example.org

# Integrations: start in mock mode; switch one at a time after approval.
HAYAH_SHEETS_BACKEND=mock
HAYAH_DRIVE_BACKEND=mock
HAYAH_WHATSAPP_BACKEND=mock
# rules = free offline extraction; anthropic = paid API (needs approval)
HAYAH_AI_BACKEND=rules

# Google (files go in ./secrets, created by scripts/google_oauth.py)
HAYAH_GOOGLE_CREDENTIALS_FILE=google-oauth-token.json
HAYAH_GOOGLE_SERVICE_ACCOUNT_FILE=
HAYAH_SHEETS_SPREADSHEET_ID=
HAYAH_DRIVE_ROOT_FOLDER_ID=

# WhatsApp Cloud API (dedicated intake number only, never the main business number)
HAYAH_WHATSAPP_VERIFY_TOKEN=
HAYAH_WHATSAPP_APP_SECRET=
HAYAH_WHATSAPP_ACCESS_TOKEN=
HAYAH_WHATSAPP_PHONE_NUMBER_ID=

# Anthropic API (production AI). Claude Pro does not include API credits.
HAYAH_ANTHROPIC_API_KEY=
HAYAH_AI_MONTHLY_BUDGET_USD=100
